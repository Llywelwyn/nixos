#!/usr/bin/env bash

server=https://file.ily.rs
token_file=/run/secrets/rustypaste-delete-token

usage() {
  cat <<EOF
usage: upload [-e <expiry>] [-n <name>] [-1] <file>...
       <command> | upload [-e <expiry>] [-n <name>] [-1]
       upload -d <name-or-url>...

Uploads files (or stdin) to $server and prints the URL of each
upload. Piped input is stored under a random name with a .txt extension.

  -e <expiry>  delete the upload after a duration, e.g. 30s, 10min, 1h, 7d
  -n <name>    use a custom name instead of a random one
  -1           one-shot: delete the upload after its first download
  -d           delete uploads by name or URL
  -h           show this help
EOF
  exit "${1:-1}"
}

field=file
delete=
curl_args=()

while getopts e:n:1dh opt; do
  case $opt in
    e) curl_args+=(-H "expire:$OPTARG") ;;
    n) curl_args+=(-H "filename:$OPTARG") ;;
    1) field=oneshot ;;
    d) delete=1 ;;
    h) usage 0 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

if [ -n "$delete" ]; then
  [ $# -gt 0 ] || usage
  if [ ! -r "$token_file" ]; then
    echo "upload: cannot read $token_file" >&2
    exit 1
  fi
  auth="Authorization: $(tr -d '\n' < "$token_file")"
  for t in "$@"; do
    curl -X DELETE -H "$auth" "$server/${t##*/}"
  done
  exit
fi

if [ $# -eq 0 ] && [ -t 0 ]; then
  usage
fi

if [ $# -eq 0 ]; then
  curl "${curl_args[@]}" -F "$field=@-" "$server"
else
  for f in "$@"; do
    curl "${curl_args[@]}" -F "$field=@$f" "$server"
  done
fi
